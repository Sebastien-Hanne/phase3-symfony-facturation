{% extends 'base.html.twig' %}

{% block title %}Connectez-vous{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 flex flex-col items-center justify-center px-4 py-12">

    {# Icône + titres #}
    <div class="text-center mb-8">
        <div class="w-14 h-14 border-2 border-blue-600 rounded-xl flex items-center justify-center mx-auto mb-3 text-blue-600">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <path d="M12 6v1m0 10v1m-2.5-3.5A2.5 2.5 0 0 0 12 17a2.5 2.5 0 0 0 0-5 2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 0 2.5-2.5" stroke-linecap="round"/>
            </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Connectez-vous</h1>
        <p class="text-sm text-gray-500 mt-1">
            Ou <a href="{{ path('app_register') }}" class="text-blue-600 hover:underline font-medium">créez un compte gratuitement</a>
        </p>
    </div>

    {# Carte #}
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 w-full max-w-md">

        {% if error %}
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">

            {# Email #}
            <div class="flex flex-col mb-4">
                <label for="username" class="text-xs font-semibold text-gray-700 mb-1">Adresse Email</label>
                <input type="email"
                       value="{{ last_username }}"
                       name="_username"
                       id="username"
                       placeholder="contact@entreprise.fr"
                       autocomplete="email"
                       required
                       autofocus
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            </div>

            {# Mot de passe #}
            <div class="flex flex-col mb-6">
                <label for="password" class="text-xs font-semibold text-gray-700 mb-1">Mot de passe</label>
                <input type="password"
                       name="_password"
                       id="password"
                       placeholder="••••••••"
                       autocomplete="current-password"
                       required
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {# Bouton #}
            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg text-sm transition-colors duration-150">
                Se connecter
            </button>

        </form>

    </div>
</div>
{% endblock %}