{# templates/product/new.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 relative">
        <a href="{{ path('app_product_index') }}" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </a>
        
        <h2 class="text-xl font-bold text-slate-800 mb-6 text-center">Nouveau produit</h2>
        
        {{ include('product/_form.html.twig') }} 
    </div>
</div>
{% endblock %}