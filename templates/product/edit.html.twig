{# templates/product/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Modifier le produit{% endblock %}

{% block body %}
{# Overlay sombre en arrière-plan #}
<div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    
    {# Boîte blanche (Modale) #}
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg p-10 relative">
        
        {# Titre identique à la création #}
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Modifier le produit</h2>
        
        {# On inclut le formulaire (qui a déjà le style indigo/arrondi) #}
        {{ include('product/_form.html.twig', {'button_label': 'Mettre à jour'}) }} 

        {# Bouton fermer/retour discret en haut à droite #}
        <a href="{{ path('app_product_index') }}" class="absolute top-8 right-8 text-slate-400 hover:text-slate-600 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </a>
        
        {# Optionnel : Petit bouton de suppression en bas si tu veux pouvoir supprimer depuis l'édition #}
        <div class="mt-4 pt-4 border-t border-slate-100 flex justify-start">
            {{ include('product/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}