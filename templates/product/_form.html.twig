{# templates/product/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
    <div>
        {{ form_label(form.name, 'Nom', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700 mb-1'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition'}}) }}
        <div class="text-red-500 text-xs mt-1">{{ form_errors(form.name) }}</div>
    </div>

    <div>
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700 mb-1'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition', 'rows': '3'}}) }}
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            {{ form_label(form.price, 'Prix', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700 mb-1'}}) }}
            {{ form_widget(form.price, {'attr': {'class': 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition'}}) }}
        </div>
        <div>
            {{ form_label(form.unit, 'Unité', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700 mb-1'}}) }}
            {{ form_widget(form.unit, {'attr': {'class': 'w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition bg-white'}}) }}
        </div>
    </div>

    <div class="flex justify-end gap-3 mt-8">
        <a href="{{ path('app_product_index') }}" class="px-6 py-2 border border-slate-300 text-slate-600 font-semibold rounded-lg hover:bg-slate-50 transition">
            Annuler
        </a>
        <button class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 shadow-md transition">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}