{% extends 'base.html.twig' %}

{% block title %}Créez votre compte{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 flex flex-col items-center justify-center px-4 py-12">

    {# Icône + titres #}
    <div class="text-center mb-8">
        <div class="w-14 h-14 border-2 border-blue-600 rounded-xl flex items-center justify-center mx-auto mb-3 text-blue-600">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <path d="M12 6v1m0 10v1m-2.5-3.5A2.5 2.5 0 0 0 12 17a2.5 2.5 0 0 0 0-5 2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 0 2.5-2.5" stroke-linecap="round"/>
            </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Créez votre compte</h1>
        <p class="text-sm text-gray-500 mt-1">
            Ou <a href="{{ path('app_login') }}" class="text-blue-600 hover:underline font-medium">connectez-vous à votre compte</a>
        </p>
    </div>

    {# Carte #}
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 w-full max-w-md">

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4" role="alert">
                {{ flash_error }}
            </div>
        {% endfor %}

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm, { attr: { novalidate: 'novalidate', class: '' } }) }}

            {# Prénom + Nom #}
            <div class="flex gap-4 mb-4">
                <div class="flex flex-col flex-1">
                    {{ form_label(registrationForm['first_Name'], 'Prénom', { label_attr: { class: 'text-xs font-semibold text-gray-700 mb-1' } }) }}
                    {{ form_widget(registrationForm['first_Name'], { attr: { placeholder: 'Jean', class: 'w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100' } }) }}
                    {{ form_errors(registrationForm['first_Name']) }}
                </div>
                <div class="flex flex-col flex-1">
                    {{ form_label(registrationForm['last_Name'], 'Nom', { label_attr: { class: 'text-xs font-semibold text-gray-700 mb-1' } }) }}
                    {{ form_widget(registrationForm['last_Name'], { attr: { placeholder: 'Dupont', class: 'w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100' } }) }}
                    {{ form_errors(registrationForm['last_Name']) }}
                </div>
            </div>

            {# Raison Sociale #}
            <div class="flex flex-col mb-4">
                {{ form_label(registrationForm['company_Name'], 'Raison Sociale', { label_attr: { class: 'text-xs font-semibold text-gray-700 mb-1' } }) }}
                {{ form_widget(registrationForm['company_Name'], { attr: { placeholder: 'Tech Solutions', class: 'w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100' } }) }}
                {{ form_errors(registrationForm['company_Name']) }}
            </div>

            {# IBAN #}
            <div class="flex flex-col mb-4">
                {{ form_label(registrationForm['iban'], 'IBAN', { label_attr: { class: 'text-xs font-semibold text-gray-700 mb-1' } }) }}
                {{ form_widget(registrationForm['iban'], { attr: { placeholder: 'FR76 1234 5678 9012 3456 7890 123', class: 'w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100' } }) }}
                {{ form_errors(registrationForm['iban']) }}
            </div>

            {# Email #}
            <div class="flex flex-col mb-4">
                {{ form_label(registrationForm['email'], 'Adresse Email', { label_attr: { class: 'text-xs font-semibold text-gray-700 mb-1' } }) }}
                {{ form_widget(registrationForm['email'], { attr: { placeholder: 'contact@entreprise.fr', class: 'w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100' } }) }}
                {{ form_errors(registrationForm['email']) }}
            </div>

            {# Mot de passe #}
            <div class="flex flex-col mb-6">
                {{ form_label(registrationForm['plainPassword'], 'Mot de passe', { label_attr: { class: 'text-xs font-semibold text-gray-700 mb-1' } }) }}
                {{ form_widget(registrationForm['plainPassword'], { attr: { placeholder: '••••••••', class: 'w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100' } }) }}
                {{ form_errors(registrationForm['plainPassword']) }}
            </div>

            {# Bouton #}
            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 active:scale-99 text-white font-semibold py-3 rounded-lg text-sm transition-colors duration-150">
                Créer mon compte
            </button>

        {{ form_end(registrationForm) }}

    </div>
</div>
{% endblock %}