<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="...">
        
        {# Assurez-vous que Tailwind est bien chargé ici via votre importmap #}
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# ... configuration FrankenPHP ... #}
    </head>
    <body class="h-full bg-gray-50 m-0">
        <div class="flex min-h-screen">
            
            <twig:Sidebar />

            <main class="flex-1">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>