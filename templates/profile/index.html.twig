{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Sass facturation{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 p-8 font-sans text-gray-700">
    <h1 class="text-2xl font-bold mb-6">Mon Profil</h1>

    {{ form_start(profileForm) }}
    
    <div class="max-w-3xl bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
        
        {# Raison Sociale #}
        <div class="mb-6">
            <label class="block text-sm font-bold text-gray-700 mb-2">Raison Sociale</label>
            {{ form_widget(profileForm.company_name, {
                'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-gray-800'}
            }) }}
            <p class="mt-2 text-sm text-gray-500">Le nom de votre entreprise qui apparaîtra sur vos factures.</p>
        </div>

        {# Numéro SIRET #}
        <div class="mb-6">
            <label class="block text-sm font-bold text-gray-700 mb-2">Numéro SIRET (Optionnel)</label>
            {{ form_widget(profileForm.siret, {
                'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none'}
            }) }}
        </div>

        {# IBAN #}
        <div class="mb-6">
            <label class="block text-sm font-bold text-gray-700 mb-2">IBAN</label>
            {{ form_widget(profileForm.iban, {
                'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-gray-800'}
            }) }}
            <p class="mt-2 text-sm text-gray-500">Compte bancaire qui recevra les virements de vos clients.</p>
        </div>

        {# CGV - Ajusté pour occuper tout l'espace (Textarea) #}
        <div class="mb-8">
            <label class="block text-sm font-bold text-gray-700 mb-2">Conditions Générales de Vente (CGV)</label>
            {{ form_widget(profileForm.cgv, {
                'attr': {
                    'class': 'w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none placeholder-gray-400 resize-none',
                    'rows': '6',
                    'placeholder': 'Ces conditions apparaîtront en bas de vos factures PDF...'
                }
            }) }}
        </div>

        {# Bouton de soumission #}
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors shadow-md"> 
            Enregistrer les modifications
        </button>
        
    </div>

    {{ form_end(profileForm) }}
</div>
{% endblock %}