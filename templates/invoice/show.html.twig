{# templates/invoice/show.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="bg-slate-50 min-h-screen py-8 px-6">
    <div class="max-w-4xl mx-auto">

        <a href="{{ path('app_invoice_index') }}"
           class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-blue-600 transition mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour aux factures
        </a>

        {# Header avec boutons conditionnels #}
        <div class="flex justify-between items-start mb-6">
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold text-slate-900">Facture {{ invoice.number }}</h1>
                    {% if invoice.status.value == 'paid' %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                            Payée
                        </span>
                    {% elseif invoice.status.value == 'pending' %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-700">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                            En attente
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                            Brouillon
                        </span>
                    {% endif %}
                </div>
                <p class="text-sm text-slate-400 mt-1">Date: {{ invoice.creatAt ? invoice.creatAt|date('d/m/Y') : '—' }}</p>
            </div>

            <div class="flex gap-2">
                {% if invoice.status.value == 'draft' %}
                    <a href="{{ path('app_invoice_validate', {id: invoice.id}) }}"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 hover:bg-green-200 text-green-700 text-sm font-medium rounded-lg transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Valider la facture
                    </a>
                    <form method="post" action="{{ path('app_invoice_delete', {id: invoice.id}) }}" onsubmit="return confirm('Supprimer cette facture ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
                        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 border border-red-200 hover:bg-red-50 text-red-500 text-sm font-medium rounded-lg transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>
                            </svg>
                            Supprimer
                        </button>
                    </form>

                {% elseif invoice.status.value == 'pending' %}
                    <a href="{{ path('app_invoice_pdf', {id: invoice.id}) }}"
                       class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm font-medium rounded-lg transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                        PDF
                    </a>
                    <button class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm font-medium rounded-lg transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                        </svg>
                        Envoyer
                    </button>
                    <a href="{{ path('app_invoice_pay', {id: invoice.id}) }}"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 hover:bg-green-200 text-green-700 text-sm font-medium rounded-lg transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Valider le paiement
                    </a>

                {% else %}
                    <a href="{{ path('app_invoice_pdf', {id: invoice.id}) }}"
                       class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm font-medium rounded-lg transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                        PDF
                    </a>
                    <button class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm font-medium rounded-lg transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                        </svg>
                        Envoyer
                    </button>
                {% endif %}
            </div>
        </div>

        {# Document facture #}
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-10">

            <div class="flex justify-between items-start mb-10">
                <div>
                    <p class="text-lg font-bold text-slate-900">
                        {{ invoice.user ? (invoice.user.name ?? invoice.user.email) : '—' }}
                    </p>
                    {% if invoice.user %}
                        <p class="text-sm text-slate-500 mt-0.5">{{ invoice.user.email }}</p>
                    {% endif %}
                </div>
                <div class="text-right">
                    <p class="text-2xl font-black text-slate-900 tracking-widest">FACTURE</p>
                    <p class="text-sm text-slate-500 mt-1">N° {{ invoice.number }}</p>
                    <p class="text-sm text-slate-500">Date : {{ invoice.creatAt ? invoice.creatAt|date('d/m/Y') : '—' }}</p>
                </div>
            </div>

            {% if invoice.client %}
            <div class="flex justify-end mb-10">
                <div class="bg-slate-50 rounded-xl p-5 w-72">
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-2">Facturé à</p>
                    <p class="font-bold text-slate-800">{{ invoice.client.name }}</p>
                    {% if invoice.client.address %}
                        <p class="text-sm text-slate-500 mt-1">{{ invoice.client.address }}</p>
                    {% endif %}
                    {% if invoice.client.email %}
                        <p class="text-sm text-slate-500">{{ invoice.client.email }}</p>
                    {% endif %}
                    {% if invoice.client.siret %}
                        <p class="text-sm text-slate-500">SIRET : {{ invoice.client.siret }}</p>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {# Lignes de facture #}
            <table class="w-full text-sm mb-8">
                <thead>
                    <tr class="border-b-2 border-slate-900">
                        <th class="text-left pb-3 font-semibold text-slate-700">Description</th>
                        <th class="text-right pb-3 font-semibold text-slate-700">Qté</th>
                        <th class="text-right pb-3 font-semibold text-slate-700">Prix Unitaire</th>
                        <th class="text-right pb-3 font-semibold text-slate-700">Total TTC</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% if invoice.invoiceItems is defined and invoice.invoiceItems|length > 0 %}
                        {% for item in invoice.invoiceItems %}
                        <tr>
                            <td class="py-4">
                                <p class="font-medium text-slate-800">{{ item.product ? item.product.name : '—' }}</p>
                                {% if item.product and item.product.description %}
                                    <p class="text-slate-400 text-xs mt-0.5">{{ item.product.description }}</p>
                                {% endif %}
                            </td>
                            <td class="py-4 text-right text-slate-600">{{ item.quantity }}</td>
                            <td class="py-4 text-right text-slate-600">{{ item.product ? item.product.price|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
                            <td class="py-4 text-right font-semibold text-slate-800">
                                {{ item.product ? (item.quantity * item.product.price)|number_format(2, ',', ' ') ~ ' €' : '—' }}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="4" class="py-6 text-slate-400 italic text-center">Aucune ligne de facture.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>

            {# Totaux #}
            <div class="flex justify-end mb-8">
                <div class="w-64 space-y-2">
                    <div class="flex justify-between text-sm text-slate-600">
                        <span>Total HT</span>
                        <span>{{ invoice.totalTtc|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="flex justify-between font-bold text-slate-900 border-t border-slate-900 pt-2">
                        <span>Total TTC</span>
                        <span class="text-lg">{{ invoice.totalTtc|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <p class="text-xs text-slate-400 text-right">TVA non applicable, art. 293 B du CGI</p>
                </div>
            </div>

            {% if invoice.client and invoice.client.rib %}
            <div class="border-t border-slate-100 pt-6">
                <p class="text-sm font-medium text-slate-700 mb-2">Conditions de paiement</p>
                <div class="bg-slate-50 rounded-lg p-4">
                    <p class="text-sm text-slate-500">Coordonnées bancaires pour le paiement :</p>
                    <p class="text-sm font-mono text-slate-700 mt-1">{{ invoice.client.rib }}</p>
                </div>
            </div>
            {% endif %}

        </div>
    </div>
</div>
{% endblock %}