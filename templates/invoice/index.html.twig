{# templates/invoice/index.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="bg-slate-50 min-h-screen py-10 px-6">
    <div class="max-w-5xl mx-auto">

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-black text-slate-900">Factures</h1>
            <a href="{{ path('app_invoice_new') }}"
               class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
                Nouvelle facture
            </a>
        </div>

        {# Filtres #}
        <div class="flex gap-2 mb-6">
            <button onclick="filterInvoices('all')" id="filter-all"
                    class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium bg-blue-100 text-blue-700 transition">
                Toutes
            </button>
            <button onclick="filterInvoices('draft')" id="filter-draft"
                    class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                Brouillons
            </button>
            <button onclick="filterInvoices('pending')" id="filter-pending"
                    class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                En attente
            </button>
            <button onclick="filterInvoices('paid')" id="filter-paid"
                    class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                Payées
            </button>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full text-sm text-left">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Numéro</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Statut</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Total TTC</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Date</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for invoice in invoices %}
                    <tr class="hover:bg-slate-50 transition invoice-row" data-status="{{ invoice.status.value }}">
                        <td class="px-6 py-4 font-medium text-slate-800">{{ invoice.number }}</td>
                        <td class="px-6 py-4">
                            {% if invoice.status.value == 'paid' %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Payée</span>
                            {% elseif invoice.status.value == 'pending' %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-700">En attente</span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">Brouillon</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-slate-700">{{ invoice.totalTtc|number_format(2, ',', ' ') }} €</td>
                        <td class="px-6 py-4 text-slate-500 text-xs">
                            {{ invoice.creatAt ? invoice.creatAt|date('d/m/Y') : '—' }}
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex justify-end items-center gap-2">
                                <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}"
                                   class="p-1.5 text-slate-400 hover:text-slate-600 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}"
                                   class="p-1.5 text-blue-400 hover:text-blue-600 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a4 4 0 01-1.414.914l-3 1 1-3a4 4 0 01.914-1.414z"/>
                                    </svg>
                                </a>
                                {{ include('invoice/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400 text-sm">Aucune facture pour le moment.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>

<script>
function filterInvoices(status) {
    document.querySelectorAll('.invoice-row').forEach(row => {
        row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-blue-100', 'text-blue-700');
        btn.classList.add('bg-slate-100', 'text-slate-600');
    });

    const active = document.getElementById('filter-' + status);
    if (active) {
        active.classList.remove('bg-slate-100', 'text-slate-600');
        active.classList.add('bg-blue-100', 'text-blue-700');
    }
}
</script>
{% endblock %}