{# templates/invoice/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

    <div class="grid grid-cols-2 gap-4">
        <div>
            {{ form_label(form.number, 'Numéro de facture', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.number, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
        <div>
            {{ form_label(form.status, 'Statut', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.status, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            {{ form_label(form.total_ttc, 'Total TTC (€)', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.total_ttc, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
        <div>
            {{ form_label(form.creat_at, 'Date de création', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.creat_at, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
    </div>

    <div class="flex justify-end gap-3 pt-2">
        <a href="{{ path('app_invoice_index') }}"
           class="px-5 py-2.5 text-sm font-medium text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-50 transition">
            Annuler
        </a>
        <button type="submit"
                class="px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>

{{ form_end(form) }}