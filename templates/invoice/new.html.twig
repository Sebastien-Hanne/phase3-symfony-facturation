{# templates/invoice/new.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="bg-slate-50 min-h-screen py-8 px-6">
    <div class="max-w-4xl mx-auto">

        <a href="{{ path('app_invoice_index') }}"
           class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-blue-600 transition mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Retour aux factures
        </a>

        <h1 class="text-2xl font-bold text-slate-900 mb-6">Créer une facture</h1>

        {{ form_start(form, {'attr': {'id': 'invoice-form'}}) }}

            {# Informations générales #}
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-4">
                <h2 class="text-base font-semibold text-slate-800 mb-4">Informations Générales</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.client, 'Client', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}}) }}
                        <div class="flex gap-2">
                            {{ form_widget(form.client, {'attr': {'class': 'flex-1 px-3 py-2.5 border border-slate-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                            <a href="{{ path('app_client_new') }}"
                               class="px-3 py-2.5 border border-slate-200 rounded-lg text-slate-500 hover:bg-slate-50 transition text-sm font-medium">+</a>
                        </div>
                    </div>
                    <div>
                        {{ form_label(form.creat_at, 'Date de la facture', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}}) }}
                        {{ form_widget(form.creat_at, {'attr': {'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                    </div>
                </div>
                <div class="mt-4">
                    {{ form_label(form.number, 'Numéro de facture', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}}) }}
                    {{ form_widget(form.number, {'attr': {'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500'}}) }}
                </div>
            </div>

            {# Champs cachés #}
            <div class="hidden">
                {{ form_widget(form.status) }}
                {{ form_widget(form.total_ttc) }}
            </div>

            {# Lignes de la facture #}
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-4">
                <h2 class="text-base font-semibold text-slate-800 mb-4">Lignes de la facture</h2>

                <table class="w-full text-sm mb-4">
                    <thead>
                        <tr class="border-b border-slate-200">
                            <th class="text-left pb-3 font-semibold text-slate-600">Produit / Service</th>
                            <th class="text-right pb-3 font-semibold text-slate-600 w-20">Qté</th>
                            <th class="text-right pb-3 font-semibold text-slate-600 w-32">Prix Unitaire</th>
                            <th class="text-right pb-3 font-semibold text-slate-600 w-32">Total</th>
                            <th class="w-10"></th>
                        </tr>
                    </thead>
                    <tbody id="invoice-lines">
                        <tr id="empty-line">
                            <td colspan="5" class="py-6 text-center text-slate-400 text-sm italic">Aucune ligne ajoutée.</td>
                        </tr>
                    </tbody>
                </table>

                {# Ajouter une ligne — prix caché, rempli automatiquement #}
                <div class="bg-slate-50 rounded-xl p-4">
                    <div class="grid grid-cols-12 gap-3 items-end">
                        <div class="col-span-8">
                            <label class="block text-xs font-medium text-slate-500 mb-1">Sélectionner un produit</label>
                            <select id="product-select"
                                    class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">-- Choisir --</option>
                                {% for product in products %}
                                    <option value="{{ product.id }}"
                                            data-name="{{ product.name }}"
                                            data-description="{{ product.description ?? '' }}"
                                            data-price="{{ product.price }}">
                                        {{ product.name }} — {{ product.price|number_format(2, ',', ' ') }} €
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-span-2">
                            <label class="block text-xs font-medium text-slate-500 mb-1">Quantité</label>
                            <input type="number" id="product-qty" value="1" min="1"
                                   class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div class="col-span-2">
                            <button type="button" onclick="addLine()"
                                    class="w-full px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white text-sm font-medium rounded-lg transition">
                                + Ajouter
                            </button>
                        </div>
                    </div>
                    {# Prix récupéré automatiquement depuis le produit #}
                    <input type="hidden" id="product-price">
                </div>

                <div class="flex justify-end mt-6 pt-4 border-t border-slate-100">
                    <div>
                        <span class="text-sm font-semibold text-slate-700">Total Facture (TTC) : </span>
                        <span class="text-xl font-bold text-blue-600" id="invoice-total">0.00 €</span>
                    </div>
                </div>

                <input type="hidden" name="invoice_lines" id="invoice-lines-data">
            </div>

            {# Boutons #}
            <div class="flex justify-end gap-3">
                <a href="{{ path('app_invoice_index') }}"
                   class="px-5 py-2.5 text-sm font-medium text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-50 transition">
                    Annuler
                </a>
                <button type="submit" name="save_as" value="draft"
                        class="px-5 py-2.5 text-sm font-medium text-blue-600 border border-blue-200 rounded-lg hover:bg-blue-50 transition">
                    Enregistrer en brouillon
                </button>
                <button type="submit" name="save_as" value="pending"
                        class="px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition">
                    Enregistrer et valider
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
let lines = [];

document.getElementById('product-select').addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    document.getElementById('product-price').value = opt.value ? opt.dataset.price : '';
});

function addLine() {
    const select = document.getElementById('product-select');
    const opt = select.options[select.selectedIndex];
    const qty = parseFloat(document.getElementById('product-qty').value) || 1;
    const price = parseFloat(document.getElementById('product-price').value) || 0;

    if (!opt.value) { alert('Veuillez sélectionner un produit.'); return; }

    lines.push({
        id: opt.value,
        name: opt.dataset.name,
        description: opt.dataset.description,
        qty: qty,
        price: price,
        total: qty * price
    });

    select.value = '';
    document.getElementById('product-qty').value = 1;
    document.getElementById('product-price').value = '';

    renderLines();
}

function removeLine(i) {
    lines.splice(i, 1);
    renderLines();
}

function renderLines() {
    const tbody = document.getElementById('invoice-lines');
    let total = 0;
    let html = '';

    if (lines.length === 0) {
        tbody.innerHTML = '<tr id="empty-line"><td colspan="5" class="py-6 text-center text-slate-400 text-sm italic">Aucune ligne ajoutée.</td></tr>';
        document.getElementById('invoice-total').textContent = '0.00 €';
        document.getElementById('invoice-lines-data').value = '[]';
        const tf = document.querySelector('[id$="_total_ttc"]');
        if (tf) tf.value = '0.00';
        return;
    }

    lines.forEach((line, i) => {
        total += line.total;
        html += `<tr class="border-b border-slate-100">
            <td class="py-3">
                <p class="font-medium text-slate-800">${line.name}</p>
                ${line.description ? `<p class="text-slate-400 text-xs mt-0.5">${line.description}</p>` : ''}
            </td>
            <td class="py-3 text-right text-slate-600">${line.qty}</td>
            <td class="py-3 text-right text-slate-600">${line.price.toFixed(2)} €</td>
            <td class="py-3 text-right font-semibold text-slate-800">${line.total.toFixed(2)} €</td>
            <td class="py-3 text-right">
                <button type="button" onclick="removeLine(${i})" class="p-1 text-red-400 hover:text-red-600 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>
                    </svg>
                </button>
            </td>
        </tr>`;
    });

    tbody.innerHTML = html;
    document.getElementById('invoice-total').textContent = total.toFixed(2) + ' €';
    document.getElementById('invoice-lines-data').value = JSON.stringify(lines);

    const tf = document.querySelector('[id$="_total_ttc"]');
    if (tf) tf.value = total.toFixed(2);
}

document.getElementById('invoice-form').addEventListener('submit', function() {
    const total = lines.reduce((sum, l) => sum + l.total, 0);
    const tf = document.querySelector('[id$="_total_ttc"]');
    if (tf) tf.value = total.toFixed(2);
});
</script>
{% endblock %}