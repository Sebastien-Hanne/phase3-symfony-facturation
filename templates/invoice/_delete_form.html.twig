{# templates/invoice/_delete_form.html.twig #}
<form method="post" action="{{ path('app_invoice_delete', {'id': invoice.id}) }}"
      onsubmit="return confirm('Supprimer cette facture ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
    <button type="submit" class="p-1.5 text-red-400 hover:text-red-600 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/>
        </svg>
    </button>
</form>