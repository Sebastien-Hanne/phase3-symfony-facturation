{# templates/client/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

    <div>
        {{ form_label(form.name, 'Nom du client / Entreprise', {
            'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
        }) }}
        {{ form_widget(form.name, {'attr': {
            'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
        }}) }}
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            {{ form_label(form.email, 'Email', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.email, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
        <div>
            {{ form_label(form.phone, 'Téléphone', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.phone, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
    </div>

    <div>
        {{ form_label(form.address, 'Adresse', {
            'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
        }) }}
        {{ form_widget(form.address, {'attr': {
            'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition',
            'rows': 3
        }}) }}
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            {{ form_label(form.siret, 'SIRET (Optionnel)', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.siret, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
        <div>
            {{ form_label(form.rib, 'RIB (Optionnel)', {
                'label_attr': {'class': 'block text-sm font-medium text-slate-700 mb-1.5'}
            }) }}
            {{ form_widget(form.rib, {'attr': {
                'class': 'w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition'
            }}) }}
        </div>
    </div>

    <div class="flex justify-end gap-3 pt-2">
        <a href="{{ path('app_client_index') }}"
           class="px-5 py-2.5 text-sm font-medium text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-50 transition">
            Annuler
        </a>
        <button type="submit"
                class="px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition">
            Enregistrer
        </button>
    </div>

{{ form_end(form) }}