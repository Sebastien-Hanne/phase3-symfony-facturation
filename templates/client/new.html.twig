{# templates/client/new.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="bg-slate-50 min-h-screen py-10 px-6">
    <div class="max-w-5xl mx-auto">

        {# Page title #}
        <h2 class="text-center text-sm font-semibold text-slate-500 uppercase tracking-widest mb-6">
            Ajouter un nouveau client
        </h2>

        {# Modal card #}
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm max-w-xl mx-auto mb-10">
            <div class="flex justify-between items-start px-6 pt-6 pb-2">
                <h1 class="text-lg font-bold text-slate-800">Nouveau client</h1>
                <a href="{{ path('app_client_index') }}"
                   class="text-slate-400 hover:text-slate-600 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </a>
            </div>
            <div class="px-6 pb-6">
                {{ include('client/_form.html.twig') }}
            </div>
        </div>

        {# Clients existants #}
        <h2 class="text-base font-semibold text-slate-700 mb-4 text-center">Clients existants</h2>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full text-sm text-left">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Nom</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Contact</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide">Adresse</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wide text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for client in clients is defined ? clients : [] %}
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4 font-medium text-slate-800">{{ client.name }}</td>
                        <td class="px-6 py-4">
                            <div class="text-slate-700">{{ client.email }}</div>
                            <div class="text-slate-400 text-xs mt-0.5">{{ client.phone }}</div>
                        </td>
                        <td class="px-6 py-4 text-slate-600">{{ client.address }}</td>
                        <td class="px-6 py-4">
                            <div class="flex justify-end items-center gap-2">
                                <a href="{{ path('app_client_edit', {id: client.id}) }}"
                                   class="p-1.5 text-blue-400 hover:text-blue-600 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a4 4 0 01-1.414.914l-3 1 1-3a4 4 0 01.914-1.414z"/>
                                    </svg>
                                </a>
                                {{ include('client/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>
{% endblock %}